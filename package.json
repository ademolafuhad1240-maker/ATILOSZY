{
  "name": "atiloszy",
  "version": "0.1.0",
  "description": "ATILOSZY - A premium variety store by SORVYRA",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "db:up": "docker compose -f docker-compose.postgres.yml --env-file .env up -d",
    "db:down": "docker compose -f docker-compose.postgres.yml --env-file .env down",
    "db:logs": "docker compose -f docker-compose.postgres.yml --env-file .env logs -f postgres",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:audit": "tsx scripts/audit-storefront-foundation.ts",
    "db:audit:catalog": "tsx scripts/audit-catalog-foundation.ts",
    "db:audit:services": "node --conditions=react-server --import tsx scripts/audit-catalog-services.ts",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "db:audit:identity": "node --env-file=.env --conditions=react-server --import tsx scripts/audit-customer-identity.ts",
    "db:audit:auth": "node --env-file=.env --conditions=react-server --import tsx scripts/audit-customer-auth-services.ts",
    "db:audit:auth-api": "node --env-file=.env --conditions=react-server --import tsx scripts/audit-auth-api-routes.ts",
    "db:audit:auth-ui": "node --env-file=.env --conditions=react-server --import tsx scripts/audit-customer-auth-pages.ts",
    "db:audit:recovery": "node --env-file=.env --conditions=react-server --import tsx scripts/audit-auth-recovery-services.ts",
    "db:audit:recovery-http": "node --env-file=.env --conditions=react-server --import tsx scripts/audit-auth-recovery-routes-pages.ts",
    "audit:auth-delivery-adapters": "node --conditions=react-server --import tsx scripts/audit-auth-delivery-adapters.ts",
    "db:audit:cart": "node --env-file=.env --conditions=react-server --import tsx scripts/audit-cart-foundation.ts",
    "db:audit:cart-services": "node --env-file=.env --conditions=react-server --import tsx scripts/audit-cart-services.ts",
    "db:audit:cart-api": "node --env-file=.env --conditions=react-server --import tsx scripts/audit-cart-api-pages.ts",
    "db:audit:live-catalog": "node --env-file=.env --conditions=react-server --import tsx scripts/audit-live-catalog-cart-integration.ts",
    "db:audit:legacy-cart-retirement": "node --env-file=.env --conditions=react-server --import tsx scripts/audit-legacy-cart-retirement.ts",
    "db:audit:orders": "node --env-file=.env --conditions=react-server --import tsx scripts/audit-order-foundation.ts",
    "db:audit:checkout-services": "node --env-file=.env --conditions=react-server --import tsx scripts/audit-checkout-services.ts",
    "db:audit:checkout-api": "node --env-file=.env --conditions=react-server --import tsx scripts/audit-checkout-api.ts",
    "db:audit:checkout-pages": "node --env-file=.env --conditions=react-server --import tsx scripts/audit-checkout-pages.ts",
    "db:audit:payment-events": "node --env-file=.env --conditions=react-server --import tsx scripts/audit-payment-provider-events.ts",
    "db:audit:payment-transitions": "node --env-file=.env --conditions=react-server --import tsx scripts/audit-payment-transitions.ts",
    "db:audit:payment-initiation-api": "node --env-file=.env --conditions=react-server --import tsx scripts/audit-payment-initiation-api.ts",
    "db:audit:payment-provider-adapters": "node --conditions=react-server --import tsx scripts/audit-payment-provider-adapters.ts",
    "db:audit:payment-webhooks": "node --conditions=react-server --import tsx scripts/audit-payment-webhooks.ts",
    "db:audit:payment-reconciliation": "node --conditions=react-server --import tsx scripts/audit-payment-reconciliation.ts",
    "audit:customer-payment-ui": "node --import tsx scripts/audit-customer-payment-ui.ts",
    "audit:staff-order-operations": "node --import tsx scripts/audit-staff-order-operations.ts",
    "db:audit:staff-order-services": "node --env-file=.env --conditions=react-server --import tsx scripts/audit-staff-order-services.ts",
    "staff:provision": "node --env-file=.env --conditions=react-server --import tsx scripts/provision-storefront-staff.ts",
    "platform-admin:provision": "node --env-file=.env --conditions=react-server --import tsx scripts/provision-platform-administrator.ts",
    "audit:staff-governance": "node --import tsx scripts/audit-staff-governance.ts",
    "db:audit:staff-governance-services": "node --env-file=.env --conditions=react-server --import tsx scripts/audit-staff-governance-services.ts",
    "audit:catalog-management": "node --import tsx scripts/audit-catalog-management.ts",
    "audit:quantity-pricing": "node --conditions=react-server --import tsx scripts/audit-quantity-pricing.ts",
    "audit:catalog-media": "node --conditions=react-server --import tsx scripts/audit-catalog-media.ts",
    "db:audit:catalog-management": "node --env-file-if-exists=.env --conditions=react-server --import tsx scripts/audit-catalog-management-services.ts",
    "audit:railway-readiness": "node --import tsx scripts/audit-railway-readiness.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^0.408.0",
    "next": "15.5.21",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.21",
    "postcss": "8.5.23",
    "prisma": "^7.9.1",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.23.1",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "sharp": "$sharp",
    "postcss": "$postcss"
  }
}
