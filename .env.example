POSTGRES_DB=sorvyra_commerce
POSTGRES_USER=sorvyra
POSTGRES_PASSWORD=replace_with_a_secure_local_password

DATABASE_URL=postgresql://sorvyra:replace_with_a_secure_local_password@127.0.0.1:5432/sorvyra_commerce?schema=public
DIRECT_URL=postgresql://sorvyra:replace_with_a_secure_local_password@127.0.0.1:5432/sorvyra_commerce?schema=public

# Customer authentication
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:3000
AUTH_TRUSTED_ORIGINS=
AUTH_REGISTRATION_API_ENABLED=false

# Verification and recovery delivery
AUTH_DELIVERY_PROVIDER=disabled
AUTH_EMAIL_FROM=
AUTH_SMS_SENDER=

# Product payment initiation
# Keep disabled by default. Use test credentials for local provider checks.
PAYMENT_INITIATION_PROVIDER=disabled

# Paystack hosted checkout (server initialization uses the secret key only)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Flutterwave hosted checkout (encryption key is reserved for future encrypted operations)
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
