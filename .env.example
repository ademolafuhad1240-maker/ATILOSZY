POSTGRES_DB=sorvyra_commerce
POSTGRES_USER=sorvyra
POSTGRES_PASSWORD=replace_with_a_secure_local_password

DATABASE_URL=postgresql://sorvyra:replace_with_a_secure_local_password@127.0.0.1:5432/sorvyra_commerce?schema=public
DIRECT_URL=postgresql://sorvyra:replace_with_a_secure_local_password@127.0.0.1:5432/sorvyra_commerce?schema=public

# Customer authentication
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:3000
AUTH_TRUSTED_ORIGINS=
AUTH_REGISTRATION_API_ENABLED=false

# Verification and recovery delivery
# Supported: disabled, resend, resend-twilio
AUTH_DELIVERY_PROVIDER=disabled
AUTH_DELIVERY_TIMEOUT_MS=8000
AUTH_EMAIL_FROM=SORVYRA STORE <accounts@your-verified-domain.example>
AUTH_SMS_SENDER=

# Resend email delivery
RESEND_API_KEY=

# Optional Twilio SMS delivery (not required for account activation)
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_KEY_SECRET=
# Configure either AUTH_SMS_SENDER or TWILIO_MESSAGING_SERVICE_SID, not both.
TWILIO_MESSAGING_SERVICE_SID=

# Staff operations
# Enable only for a one-off protected staff provisioning command.
STAFF_PROVISIONING_ENABLED=false

# SORVYRA platform administrator provisioning
# Enable only for one protected provisioning command, then disable immediately.
PLATFORM_ADMIN_PROVISIONING_ENABLED=false

# Product photo storage
# Supported: disabled, cloudinary
CATALOG_MEDIA_PROVIDER=disabled
CATALOG_MEDIA_UPLOAD_TIMEOUT_MS=15000

# Cloudinary server upload credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Product payment initiation
# Keep disabled by default. Use test credentials for local provider checks.
PAYMENT_INITIATION_PROVIDER=disabled

# Paystack hosted checkout (server initialization uses the secret key only)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Flutterwave hosted checkout (encryption key is reserved for future encrypted operations)
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=

# Set the same random secret hash in the Flutterwave webhook dashboard.
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
